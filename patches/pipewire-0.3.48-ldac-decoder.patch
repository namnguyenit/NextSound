+#ifdef ENABLE_LDAC_DEC
+static int codec_start_decode(void *data,
+		const void *src, size_t src_size, uint16_t *seqnum, uint32_t *timestamp)
+{
+	struct impl *this = data;
+	const struct rtp_header *header = src;
+	const struct rtp_payload *payload = SPA_PTROFF(src,
+			sizeof(struct rtp_header), struct rtp_payload);
+	size_t header_size = sizeof(struct rtp_header) + sizeof(struct rtp_payload);
+
+	if (src_size <= header_size)
+		return -EINVAL;
+	if (seqnum)
+		*seqnum = ntohs(header->sequence_number);
+	if (timestamp)
+		*timestamp = ntohl(header->timestamp);
+	this->decode_frames = payload->frame_count;
+	return header_size;
+}
+
+static int write_pcm(struct impl *this, const int16_t *pcm, int samples,
+		void *dst, size_t dst_size)
+{
+	uint8_t *out = dst;
+	int i;
+	int sample_size;
+
+	switch (this->fmt) {
+	case LDACBT_SMPL_FMT_S16: sample_size = 2; break;
+	case LDACBT_SMPL_FMT_S24: sample_size = 3; break;
+	case LDACBT_SMPL_FMT_S32:
+	case LDACBT_SMPL_FMT_F32: sample_size = 4; break;
+	default: return -EINVAL;
+	}
+	if ((size_t)samples * sample_size > dst_size)
+		return -ENOSPC;
+
+	for (i = 0; i < samples; i++) {
+		switch (this->fmt) {
+		case LDACBT_SMPL_FMT_S16:
+			memcpy(out + i * 2, &pcm[i], 2);
+			break;
+		case LDACBT_SMPL_FMT_S24: {
+			int32_t value = (int32_t)pcm[i] << 8;
+			out[i * 3] = value;
+			out[i * 3 + 1] = value >> 8;
+			out[i * 3 + 2] = value >> 16;
+			break;
+		}
+		case LDACBT_SMPL_FMT_S32: {
+			int32_t value = (int32_t)pcm[i] << 16;
+			memcpy(out + i * 4, &value, 4);
+			break;
+		}
+		case LDACBT_SMPL_FMT_F32: {
+			float value = (float)pcm[i] / 32768.0f;
+			memcpy(out + i * 4, &value, 4);
+			break;
+		}
+		}
+	}
+	return samples * sample_size;
+}
+
+static int codec_decode(void *data,
+		const void *src, size_t src_size,
+		void *dst, size_t dst_size, size_t *dst_out)
+{
+	struct impl *this = data;
+	uint8_t *to = dst;
+	size_t avail = dst_size;
+	size_t processed = 0;
+	int16_t pcm[MAX_FRAME_SAMPLES * 2];
+
+	*dst_out = 0;
+	for (; this->decode_frames > 0; --this->decode_frames) {
+		const uint8_t *frame = src;
+		int frame_size, consumed = 0, samples, written;
+
+		if (src_size < 3 || frame[0] != 0xaa ||
+				((frame[1] >> 5) & 0x07) > 3 ||
+				((frame[1] >> 3) & 0x03) > 2)
+			return -EINVAL;
+		frame_size = ((((int)frame[1] & 0x07) << 6) |
+				((int)frame[2] >> 2)) + 4;
+		if (frame_size < 4 || (size_t)frame_size > src_size)
+			return -EINVAL;
+		if (ldacDecode(&this->ldac_dec, (uint8_t *)src, pcm, &consumed) != 0 ||
+				consumed != frame_size ||
+				ldacdecGetSampleRate(&this->ldac_dec) != this->frequency ||
+				ldacdecGetChannelCount(&this->ldac_dec) != this->channels)
+			return -EINVAL;
+
+		samples = this->ldac_dec.frame.frameSamples * this->channels;
+		written = write_pcm(this, pcm, samples, to, avail);
+		if (written < 0)
+			return written;
+
+		src = SPA_PTROFF(src, consumed, const void);
+		src_size -= consumed;
+		processed += consumed;
+		to += written;
+		avail -= written;
+		*dst_out += written;
+	}
+	return processed;
+}
+#endif
